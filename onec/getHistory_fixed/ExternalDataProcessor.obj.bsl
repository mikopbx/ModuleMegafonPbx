Функция ПолучитьCdrАТС(ХостAsterisk, offset = 1, НовыйOffset)
	ДокументDOM = Неопределено;

	ПортСервера 				= 80;
	ПользовательСтатистики 		= "";
	ПарольПользователяСтатистики= "";
	Таймаут 					= 15;

	// 2. отправка запроса
	HTTPЗапрос = Новый HTTPЗапрос("/pbxcore/mega-pbx/cdr?limit=450&offset="+Формат(offset, "ЧДЦ=0; ЧРГ=' '; ЧГ=")+"&");

	HTTP = Новый HTTPСоединение(ХостAsterisk,ПортСервера,ПользовательСтатистики,ПарольПользователяСтатистики,,Таймаут);
	ОтветСервера = HTTP.Получить(HTTPЗапрос);

	Если ОтветСервера.КодСостояния = 302 Тогда
	// Это переадресация на другой ресурс, чаще на https.
		Location 	= ОтветСервера.Заголовки.Получить("Location");
		врДанныеURL = мРазложитьСтрокуВМассивПодстрок(Location, "/", Ложь);
		Если врДанныеURL.Количество()>=2 Тогда
			врСокет    	   = мРазложитьСтрокуВМассивПодстрок(врДанныеURL[1], ":", Ложь);
			врХостAsterisk = ?(врСокет.Количество()>0,врСокет[0], ХостAsterisk);

			ПортПоУмолчанию = 80;
			ЗащищенноеСоединение= Неопределено;
			Если Найти(НРег(врДанныеURL[0]), "http:")=0 Тогда
				ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
				ПортПоУмолчанию = 443;
			КонецЕсли;
			врПортСервера  = ?(врСокет.Количество()>1,врСокет[1], ПортПоУмолчанию);

			// Вычисляем ресурс
			врАдресСервера = Прав(Location, СтрДлина(Location) - (Найти(Location, врДанныеURL[1]) + СтрДлина(врДанныеURL[1]) - 1) );

			HTTP = Новый HTTPСоединение(врХостAsterisk, врПортСервера,ПользовательСтатистики,ПарольПользователяСтатистики,,Таймаут, ЗащищенноеСоединение);
			HTTPЗапрос = Новый HTTPЗапрос(врАдресСервера);
			ОтветСервера = HTTP.Получить(HTTPЗапрос);
		КонецЕсли;
	ИначеЕсли 400 = ОтветСервера.КодСостояния Тогда
		Защищенное = Новый ЗащищенноеСоединениеOpenSSL();
		HTTP = Новый HTTPСоединение(ХостAsterisk,ПортСервера,ПользовательСтатистики,ПарольПользователяСтатистики,,Таймаут, Защищенное);
		ОтветСервера = HTTP.Получить(HTTPЗапрос);
	КонецЕсли;

	// X-MAX-OFFSET читаем из ИТОГОВОГО ответа — после возможного редиректа (302)
	// или повторного запроса по HTTPS (400). Иначе на HTTPS-инсталляциях смещение
	// не обновляется и синхронизация "застревает" на одной странице.
	НовыйOffset = ОтветСервера.Заголовки.Получить("X-MAX-OFFSET");

	Если НЕ ОтветСервера.КодСостояния = 200 Тогда
		СообщениеHTTP = "Ошибка подключения к АТС: """ + ХостAsterisk + """. "+ Символы.ПС +
						"Код состояния HTTP " + Формат(ОтветСервера.КодСостояния, "ЧРГ=; ЧН=0; ЧГ=")+".";
		ЗаписьЖурналаРегистрации("МИКО.ЗагрузкаИсторииЗвонков",  УровеньЖурналаРегистрации.Предупреждение, , , СообщениеHTTP);
		// Не возвращаем ошибочное тело как валидные данные — прерываем загрузку,
		// чтобы вызывающий код не сдвинул offset на сбойном ответе.
		ВызватьИсключение СообщениеHTTP;
	КонецЕсли;

	//ТекстДокумента = ОтветСервера.ПолучитьТелоКакСтроку();
	//// 3. Разбор ответа
	//ЧтениеHTML 		= Новый ЧтениеHTML;
	//ПостроительDOM 	= Новый ПостроительDOM;
	//ЧтениеHTML.УстановитьСтроку(ТекстДокумента);
	//ДокументDOM = ПостроительDOM.Прочитать(ЧтениеHTML);

	Возврат ОтветСервера.ПолучитьТелоКакСтроку();
КонецФункции

// Функция "расщепляет" строку на подстроки, используя заданный.
//		разделитель. Разделитель может иметь любую длину.
//		Если в качестве разделителя задан пробел, рядом стоящие пробелы
//		считаются одним разделителем, а ведущие и хвостовые пробелы параметра Стр
//		игнорируются.
//		Например,
//		РазложитьСтрокуВМассивПодстрок(",строка 1,,,строка 2", ",") возвратит массив значений из пяти элементов,
//		три из которых - пустые строки, а
//		РазложитьСтрокуВМассивПодстрок(" строка1   строка 2", " ") возвратит массив значений из двух элементов.
//
//	Параметры:
//		Стр - 			строка, которую необходимо разложить на подстроки.
//						Параметр передается по значению.
//		Разделитель - 	строка-разделитель, по умолчанию - запятая.
//
//
//	Возвращаемое значение:
//		массив значений, элементы которого - подстроки.
//
Функция мРазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ",", ВключатьПустые = Истина) Экспорт
	Если ТипЗнч(Стр) = Тип("Массив") Тогда
		Возврат Стр;
	КонецЕсли;

	МассивСтрок = Новый Массив();
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока Истина Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = СокрЛ(Сред(Стр,Поз));
		КонецЦикла;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока Истина Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			Если ЗначениеЗаполнено(Лев(Стр,Поз-1)) Тогда
				МассивСтрок.Добавить(Лев(Стр,Поз-1));
			ИначеЕсли ВключатьПустые = Истина Тогда
				МассивСтрок.Добавить(Лев(Стр,Поз-1));
			КонецЕсли;
			Стр = Сред(Стр,Поз+ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;

	Возврат МассивСтрок;
КонецФункции

