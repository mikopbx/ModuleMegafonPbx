// В представление ЗаписиИстории пишем "entire_id", а не "no"
//
Функция РазобратьЗаписиИстории(ЗаписиИсторииXML)

	ЗаписиИстории = Новый СписокЗначений;

	// Разборем XML записей истории звонков.

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ЗаписиИсторииXML);

	Пока ЧтениеXML.Прочитать() Цикл

		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

			ТекущийУзел = ЧтениеXML.Имя;

			Если ТекущийУзел = "history_record" Тогда

				ЗаписьИстории = Новый Структура("no,entire_id,line,line_number");
				ЗаписьИстории.Вставить("details", Новый Массив);

				Пока ЧтениеXML.СледующийАтрибут() Цикл
					ЗаписьИстории.Вставить(ЧтениеXML.Имя, ЧтениеXML.Значение);
				КонецЦикла;

				// ЗаписиИстории.Добавить(ЗаписьИстории, Строка(ЗаписьИстории.no));
				ЗаписиИстории.Добавить(ЗаписьИстории, Строка(ЗаписьИстории.entire_id));

			ИначеЕсли ТекущийУзел = "details" Тогда

				ДеталиЗвонка = Новый Структура("call_id,status,call_flow,started,
					|answered,finished,record_file,voicemail,
					|from_extension,from_number,to_extension,to_number,
					|duration,conversation,queue");

				Пока ЧтениеXML.СледующийАтрибут() Цикл
					ДеталиЗвонка.Вставить(ЧтениеXML.Имя, ЧтениеXML.Значение);
				КонецЦикла;

				ЗаписьИстории.details.Добавить(ДеталиЗвонка);

			ИначеЕсли ТекущийУзел = "from" Тогда

				ДеталиЗвонка.Вставить("from_extension", ЧтениеXML.ЗначениеАтрибута("ext"));
				ДеталиЗвонка.Вставить("from_number",    ЧтениеXML.ЗначениеАтрибута("number"));

			ИначеЕсли ТекущийУзел = "to" Тогда

				ДеталиЗвонка.Вставить("to_extension",   ЧтениеXML.ЗначениеАтрибута("ext"));
				ДеталиЗвонка.Вставить("to_number",      ЧтениеXML.ЗначениеАтрибута("number"));

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Возврат ЗаписиИстории;

КонецФункции

// Поиск выполняется по entire_id, а не по номеру документа.
// Изменено формирование ключа ИдентификаторыЗвонков
Функция НайтиЗагруженныеЗаписи(ЗаписиИстории, СмещениеЗаписейЖурналаЗвонков)

	// Соберем идентификаторы звонков.

	ИдентификаторыЗвонков = Новый Массив;

	Для Каждого Запись Из ЗаписиИстории Цикл
		ИдентификаторыЗвонков.Добавить(Запись.Представление);
	КонецЦикла;

	// Найдем ранее загруженные записи для обновления информации.

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПТ20_ЗаписьЖурналаЗвонков.Ссылка,
		|	ПТ20_ЗаписьЖурналаЗвонков.entire_id КАК Номер
		|ИЗ
		|	Документ.ПТ20_ЗаписьЖурналаЗвонков КАК ПТ20_ЗаписьЖурналаЗвонков
		|ГДЕ
		|	ПТ20_ЗаписьЖурналаЗвонков.entire_id В(&Номер)";
	Запрос.УстановитьПараметр("Номер", ИдентификаторыЗвонков);

	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();

КонецФункции

// Номер документа всегда 0, а не ИдентификаторЗвонка;
// Исправлено формирование ИдентификаторЗвонка = ЭлементСписка.Представление;
Процедура ОбработатьЗаписиИстории(ЗаписиИсторииXML, МассивЗвонков)

	ЗаписиИстории = РазобратьЗаписиИстории(ЗаписиИсторииXML);
	Если ЗаписиИстории.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СмещениеЗаписейЖурналаЗвонков = СмещениеЗаписейЖурналаЗвонков();
	СлужебныеНомера = СлужебныеНомера();
	ПустаяДата = Дата("00010101");
	СмещениеДатыИБ = СмещениеСтандартногоВремени(ПолучитьЧасовойПоясИнформационнойБазы());

	тзЗагруженныеЗаписи = НайтиЗагруженныеЗаписи(ЗаписиИстории, СмещениеЗаписейЖурналаЗвонков);

	// Предотвращаем одновременное выполнение процесса загрузки истории в разных потоках,
	// чтобы избежать дублирования записей о звонках.
	НачатьТранзакцию();
	Попытка
	ПТ20_ОбщегоНазначения.УстановитьИменованнуюБлокировку("ЗагрузитьЗаписиИстории");

	// Формируем записи истории в БД.
	Для Каждого ЭлементСписка Из ЗаписиИстории Цикл

		ИдентификаторЗвонка = ЭлементСписка.Представление;
		ЗаписьИстории       = ЭлементСписка.Значение;

		ЕстьЗапись = Ложь;

		// Найдем ранее загруженный документ.
		СтрокаДокумента = тзЗагруженныеЗаписи.Найти(ИдентификаторЗвонка, "Номер");
		Если СтрокаДокумента <> Неопределено Тогда
			докЗаписьЖурналаЗвонков = СтрокаДокумента.Ссылка.ПолучитьОбъект();
			докЗаписьЖурналаЗвонков.ДеталиЗвонка.Очистить();
		Иначе
			докЗаписьЖурналаЗвонков = Документы.ПТ20_ЗаписьЖурналаЗвонков.СоздатьДокумент();
		КонецЕсли;

		ЗаполнитьЗначенияСвойств(докЗаписьЖурналаЗвонков, ЗаписьИстории);

		// Формируем расшифровку звонка.
		ВнутреннийЗвонокНаПриложение = Ложь;
		ДеталиЗвонка = докЗаписьЖурналаЗвонков.ДеталиЗвонка;

		Для Каждого СтрокаЗвонка Из ЗаписьИстории.details Цикл

			СтрокаДетализации = ДеталиЗвонка.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДетализации, СтрокаЗвонка);

			СтрокаДетализации.started  = ПТ20_ОбщегоНазначенияКлиентСервер.ДатаИзRfc3339(СтрокаЗвонка.started, СмещениеДатыИБ);
			СтрокаДетализации.answered = ПТ20_ОбщегоНазначенияКлиентСервер.ДатаИзRfc3339(СтрокаЗвонка.answered, СмещениеДатыИБ);
			СтрокаДетализации.finished = ПТ20_ОбщегоНазначенияКлиентСервер.ДатаИзRfc3339(СтрокаЗвонка.finished, СмещениеДатыИБ);

			СтрокаДетализации.call_flow = МаршрутыВызова(СтрокаЗвонка.call_flow);
			СтрокаДетализации.queue     = МаршрутыВызова(СтрокаЗвонка.queue);

			// Вычислим длительность звонка.
			СтрокаДетализации.ДлительностьЗвонка = ПТ20_ЖурналЗвонковКлиентСервер.РазностьВремени(СтрокаДетализации.started, СтрокаДетализации.finished);
			// MegaPBX возвращает один итоговый сегмент звонка. Номер назначения
			// может одновременно быть служебным номером линии, но conversation
			// уже содержит фактическую длительность разговора и не должен
			// отбрасываться как промежуточный IVR-сегмент.
			Если СтрокаДетализации.to_extension <> "@app" Тогда
				СтрокаДетализации.ДлительностьРазговора = ПустаяДата + ?(ЗначениеЗаполнено(СтрокаЗвонка.conversation), Число(СтрокаЗвонка.conversation), 0);
			ИначеЕсли ЗначениеЗаполнено(СтрокаДетализации.from_extension) Или ПустаяСтрока(СтрокаДетализации.from_number) Тогда
				ВнутреннийЗвонокНаПриложение = Истина;
			КонецЕсли;

			Если Не ПустаяСтрока(СтрокаДетализации.record_file) Или Не ПустаяСтрока(СтрокаДетализации.voicemail) Тогда
				ЕстьЗапись = Истина;
			КонецЕсли;

			Если Не ПустаяСтрока(СтрокаЗвонка.status) Тогда
				СтрокаДетализации.status = Перечисления.ПТ20_СтатусЗвонка[СтрокаЗвонка.status];
			КонецЕсли;

			Если СтрокаДетализации.ДлительностьРазговора = ПустаяДата И
				 СтрокаДетализации.status = Перечисления.ПТ20_СтатусЗвонка.ANSWER И
				 СтрокаДетализации.to_extension <> "@app" Тогда
				СтрокаДетализации.status = Перечисления.ПТ20_СтатусЗвонка.NOANSWER;
			КонецЕсли;

		КонецЦикла;

		Если ДеталиЗвонка.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Игнорируем звонки на приложения.
		Если ВнутреннийЗвонокНаПриложение Тогда
			//Продолжить;
		КонецЕсли;

		// Установим строки в порядке появления звонков.
		ДеталиЗвонка.Сортировать("started,call_id");

		// Определим направление звонка.
		ВидЗвонка = Перечисления.ПТ20_ТипыЗвонков.ПустаяСсылка();

		Если (Не ПустаяСтрока(ДеталиЗвонка[0].from_extension)) И
			 (Не ПустаяСтрока(ДеталиЗвонка[0].to_extension)) Тогда
			ВидЗвонка = Перечисления.ПТ20_ТипыЗвонков.Внутренний;
		ИначеЕсли Не ПустаяСтрока(ДеталиЗвонка[0].to_extension) Тогда
			ВидЗвонка = Перечисления.ПТ20_ТипыЗвонков.Входящий;
		ИначеЕсли Не ПустаяСтрока(ДеталиЗвонка[0].from_extension) Тогда
			ВидЗвонка = Перечисления.ПТ20_ТипыЗвонков.Исходящий;
		КонецЕсли;

		докЗаписьЖурналаЗвонков.ВидЗвонка = ВидЗвонка;

		// Определим абонентов по номерам телефонов.
		ЗаполнитьКонтактныеДанные(докЗаписьЖурналаЗвонков, СлужебныеНомера);
		ВидЗвонка = докЗаписьЖурналаЗвонков.ВидЗвонка;

		// Подсчитаем длительность разговора.
		ДлительностьРазговора = 0;
		Отвечено = Ложь;
		ВремяОтвета = ПустаяДата;
		ВидЗвонка = докЗаписьЖурналаЗвонков.ВидЗвонка;

		Для Каждого СтрокаДетализации Из ДеталиЗвонка Цикл

			Если Отвечено = Ложь И
					СтрокаДетализации.status = Перечисления.ПТ20_СтатусЗвонка.ANSWER И
					(Прав(СтрокаДетализации.to_number, 10) <> Прав(ЗаписьИстории.line_number, 10) Или СтрДлина(ЗаписьИстории.line_number) < 5) И
					СтрокаДетализации.ДлительностьРазговора <> ПустаяДата Тогда
				ВремяОтвета = СтрокаДетализации.answered;
				Отвечено = Истина;
			КонецЕсли;

			// При расчете продолжительности разговора не учитываем:
			//  - внутрениие переговоры при переадресации звонка.
			//  - ожидание на IVR.
			Если ВидЗвонка = Перечисления.ПТ20_ТипыЗвонков.Входящий И
					Прав(СтрокаДетализации.from_number, 10) <> Прав(ДеталиЗвонка[0].from_number, 10) Тогда
				Продолжить;
			ИначеЕсли ВидЗвонка = Перечисления.ПТ20_ТипыЗвонков.Исходящий И
					(Прав(СтрокаДетализации.to_number, 10) <> Прав(ДеталиЗвонка[0].to_number, 10)
						И Прав(СтрокаДетализации.from_number, 10) <> Прав(ДеталиЗвонка[0].to_number, 10)) Тогда
				Продолжить;
			КонецЕсли;

			ДлительностьРазговора = (СтрокаДетализации.ДлительностьРазговора + ДлительностьРазговора) - ПустаяДата;

		КонецЦикла;

		// Вычислим длительность звонка.
		СтрокаНачало = ПТ20_ОбщегоНазначенияКлиентСервер.НайтиСтрокуСМинимальнымЗначениемВТаблице(ДеталиЗвонка, "started");
		СтрокаКонец  = ПТ20_ОбщегоНазначенияКлиентСервер.НайтиСтрокуСМаксимальнымЗначениемВТаблице(ДеталиЗвонка, "finished");

		докЗаписьЖурналаЗвонков.ДлительностьЗвонка    = ПТ20_ЖурналЗвонковКлиентСервер.РазностьВремени(СтрокаНачало.started, СтрокаКонец.finished);
		докЗаписьЖурналаЗвонков.ДлительностьРазговора = ПТ20_ЖурналЗвонковКлиентСервер.ДлительностьВоВремя(ДлительностьРазговора);

		// Определим внешнию линию.
		Если Не ПустаяСтрока(ЗаписьИстории.line) Тогда
			докЗаписьЖурналаЗвонков.line = Провайдер(ЗаписьИстории.line);
		КонецЕсли;

		Если ВидЗвонка = Перечисления.ПТ20_ТипыЗвонков.Входящий И Не ПустаяСтрока(ЗаписьИстории.line_number) Тогда
			НайденнаяСтрока = СлужебныеНомера.Найти(ЗаписьИстории.line_number, "Номер");
			Если НайденнаяСтрока <> Неопределено Тогда
				докЗаписьЖурналаЗвонков.line = НайденнаяСтрока.Ссылка;
			КонецЕсли;
		КонецЕсли;

		//Если ВидЗвонка = Перечисления.ПТ20_ТипыЗвонков.Входящий И
		//		(ПустаяСтрока(ЗаписьИстории.line) Или ПустаяСтрока(ЗаписьИстории.line_number)) Тогда
		//	НайденнаяСтрока = СлужебныеНомера.Найти(ДеталиЗвонка[0].to_number, "Номер");
		//	Если НайденнаяСтрока <> Неопределено Тогда
		//		докЗаписьЖурналаЗвонков.line        = НайденнаяСтрока.Ссылка;
		//		докЗаписьЖурналаЗвонков.line_number = НайденнаяСтрока.Номер;
		//	КонецЕсли;
		//КонецЕсли;

		// Определим канал привлечения.
		Если ВидЗвонка = Перечисления.ПТ20_ТипыЗвонков.Входящий Тогда
			докЗаписьЖурналаЗвонков.КаналПривлечения = КаналПривлечения(докЗаписьЖурналаЗвонков.line_number);
		КонецЕсли;

		// Запишем документ.
		докЗаписьЖурналаЗвонков.Дата       = СтрокаНачало.started;
		докЗаписьЖурналаЗвонков.Номер      = 0;
		// докЗаписьЖурналаЗвонков.Номер      = ИдентификаторЗвонка;
		докЗаписьЖурналаЗвонков.Пропущен   = (ВидЗвонка = Перечисления.ПТ20_ТипыЗвонков.Входящий И Не Отвечено);
		докЗаписьЖурналаЗвонков.Отвечено   = ВремяОтвета;
		докЗаписьЖурналаЗвонков.Окончание  = СтрокаКонец.finished;
		докЗаписьЖурналаЗвонков.ЕстьЗапись = ЕстьЗапись;

		докЗаписьЖурналаЗвонков.НомерТелефонаИндекс = ПТ20_Телефония.ПреобразоватьНомерДляПоиска(докЗаписьЖурналаЗвонков.НомерТелефона);

		Если Не ЗначениеЗаполнено(докЗаписьЖурналаЗвонков.Дата) Тогда
			Продолжить;
		КонецЕсли;

		докЗаписьЖурналаЗвонков.Записать();

		// Поумолчанию все пропущенные звонки считаем необработанными.
		Если докЗаписьЖурналаЗвонков.Пропущен Тогда
			МенеджерЗаписи = РегистрыСведений.ПТ20_НеобработанныеЗвонки.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Ссылка = докЗаписьЖурналаЗвонков.Ссылка;
			МенеджерЗаписи.Записать();
		КонецЕсли;

		Если Не докЗаписьЖурналаЗвонков.Пропущен Тогда
			МассивЗвонков.Добавить(докЗаписьЖурналаЗвонков.Ссылка);
		КонецЕсли;

		// Очистим временные ассоциации со звонком в регистрах.
		МенеджерЗаписи = РегистрыСведений.ПТ20_ДанныеИсходящихЗвонков.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторЗвонка = ЗаписьИстории.entire_id;
		МенеджерЗаписи.Удалить();

		// Добавим в обработку для речевой аналитики.
		Для Каждого СтрокаЗвонка Из докЗаписьЖурналаЗвонков.ДеталиЗвонка Цикл
			Если Не ПустаяСтрока(СтрокаЗвонка.record_file)
			   И Не (ТипЗнч(СтрокаЗвонка.КтоЗвонил) = Тип("СправочникСсылка.Пользователи")
			       И ТипЗнч(СтрокаЗвонка.КомуЗвонил) = Тип("СправочникСсылка.Пользователи")) Тогда
				ПараметрыЗаписи = Новый Структура;
				ПараметрыЗаписи.Вставить("Звонок", докЗаписьЖурналаЗвонков.Ссылка);
				ПараметрыЗаписи.Вставить("ИндексСтроки", СтрокаЗвонка.НомерСтроки);
				ПараметрыЗаписи.Вставить("ЗаписьРазговора", СтрокаЗвонка.record_file);
				ПараметрыЗаписи.Вставить("ДлительностьРазговора", ПТ20_ЖурналЗвонковКлиентСервер.ВремяВДлительность(СтрокаЗвонка.ДлительностьРазговора));

				ПТ20_РаспознаваниеРечи.ПоставитьВОчередьНаРасшифрокуЗаписьРазговора(ПараметрыЗаписи);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры


