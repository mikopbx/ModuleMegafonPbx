// Методы импортированы "КАК ЕСТЬ" из ПТ20_ЖурналЗвонков ( расширение ПодсистемаТелефонии40_УТ_КА_ERP).
////////////////////////////////////////////////////////////////////////////////////////////////////////////

Функция МаршрутыВызова(Идентификатор)

	//Возврат Справочники.ПТ20_МаршрутыВызова.ПустаяСсылка();

	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Справочники.ПТ20_МаршрутыВызова.ПустаяСсылка();
	КонецЕсли;

	Если Найти(Идентификатор, "transfer;") > 0 Тогда
		Возврат Идентификатор;
	КонецЕсли;

	спрМаршрутыВызова = Справочники.ПТ20_МаршрутыВызова.НайтиПоКоду(Идентификатор);
	Если спрМаршрутыВызова = Справочники.ПТ20_МаршрутыВызова.ПустаяСсылка() Тогда
		МаршрутыВызоваОбъект = Справочники.ПТ20_МаршрутыВызова.СоздатьЭлемент();
		МаршрутыВызоваОбъект.Код = Идентификатор;
		МаршрутыВызоваОбъект.Наименование = Идентификатор;
		МаршрутыВызоваОбъект.Записать();

		спрМаршрутыВызова = МаршрутыВызоваОбъект.Ссылка;
	КонецЕсли;

	Возврат спрМаршрутыВызова;

КонецФункции

Процедура ЗаполнитьКонтактныеДанные(ДокументОбъект, СлужебныеНомера)

	ДеталиЗвонка = ДокументОбъект.ДеталиЗвонка;

	// Найдем владельцев номеров телефонов.
	НомераТелефонов = Новый Массив;
	Для Каждого СтрокаДетализации Из ДеталиЗвонка Цикл
		НомераТелефонов.Добавить(СтрокаДетализации.from_number);
		НомераТелефонов.Добавить(СтрокаДетализации.to_number);
	КонецЦикла;

	тзКонтакты = ПТ20_Телефония.НайтиВладельцевНомеровТелефонов(НомераТелефонов, ДокументОбъект.entire_id);

	Для Каждого СтрокаДетализации Из ДеталиЗвонка Цикл

		НомерКто  = ПТ20_Телефония.ПреобразоватьНомерДляПоиска(СтрокаДетализации.from_number);
		НомерКому = ПТ20_Телефония.ПреобразоватьНомерДляПоиска(СтрокаДетализации.to_number);

		СтрокаКонтактновКто  = тзКонтакты.Найти(НомерКто,  "НомерТелефонаИндекс");
		СтрокаКонтактновКому = тзКонтакты.Найти(НомерКому, "НомерТелефонаИндекс");

		Если СтрокаКонтактновКто <> Неопределено Тогда
			//ЗаполнитьКонтактноеЛицо(СтрокаКонтактновКто.Объект, СтрокаДетализации.КтоЗвонил, СтрокаДетализации.КтоЗвонилВладелец);
			СтрокаДетализации.КтоЗвонил         = СтрокаКонтактновКто.Объект;
			СтрокаДетализации.КтоЗвонилВладелец = СтрокаКонтактновКто.Владелец;
		Иначе
			СтрокаДетализации.КтоЗвонил         = Неопределено;
			СтрокаДетализации.КтоЗвонилВладелец = Неопределено;
		КонецЕсли;

		Если СтрокаКонтактновКому <> Неопределено Тогда
			//ЗаполнитьКонтактноеЛицо(СтрокаКонтактновКому.Объект, СтрокаДетализации.КомуЗвонил, СтрокаДетализации.КомуЗвонилВладелец);
			СтрокаДетализации.КомуЗвонил         = СтрокаКонтактновКому.Объект;
			СтрокаДетализации.КомуЗвонилВладелец = СтрокаКонтактновКому.Владелец;
		Иначе
			СтрокаДетализации.КомуЗвонил         = Неопределено;
			СтрокаДетализации.КомуЗвонилВладелец = Неопределено;
		КонецЕсли;

		Если СтрокаКонтактновКто = Неопределено И Не ПустаяСтрока(СтрокаДетализации.from_number) Тогда
			СтрокаКонтактновКто  = СлужебныеНомера.Найти(СтрокаДетализации.from_number, "Номер");
			Если СтрокаКонтактновКто <> Неопределено Тогда
				СтрокаДетализации.КтоЗвонил  = СтрокаКонтактновКто.Ссылка;
			КонецЕсли;
		КонецЕсли;

		Если СтрокаКонтактновКому = Неопределено И Не ПустаяСтрока(СтрокаДетализации.to_number) Тогда
			СтрокаКонтактновКому = СлужебныеНомера.Найти(СтрокаДетализации.to_number, "Номер");
			Если СтрокаКонтактновКому <> Неопределено Тогда
				СтрокаДетализации.КомуЗвонил = СтрокаКонтактновКому.Ссылка;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	// Скорректируем направление звонка.
	Если Не ЗначениеЗаполнено(ДокументОбъект.ВидЗвонка) И ДеталиЗвонка.Количество() > 0 Тогда

		КтоЗвонил = ДеталиЗвонка[0].КтоЗвонил;
		КомуЗвонил = ДеталиЗвонка[0].КомуЗвонил;

		Если ТипЗнч(КтоЗвонил) = Тип("СправочникСсылка.Пользователи") И ТипЗнч(КомуЗвонил) = Тип("СправочникСсылка.Пользователи") Тогда
			ДокументОбъект.ВидЗвонка = Перечисления.ПТ20_ТипыЗвонков.Внутренний;
		ИначеЕсли ТипЗнч(КтоЗвонил) = Тип("СправочникСсылка.Пользователи") Тогда
			ДокументОбъект.ВидЗвонка = Перечисления.ПТ20_ТипыЗвонков.Исходящий;
		Иначе
			ДокументОбъект.ВидЗвонка = Перечисления.ПТ20_ТипыЗвонков.Входящий;
		КонецЕсли;

	КонецЕсли;

	// Участники разговора.
	мСотрудники = Новый Массив;
	ТелефоныСотрудников = Новый Соответствие;
	ПрочиеУчастники = Новый Соответствие;

	тзСотрудники = Новый ТаблицаЗначений;
	тзСотрудники.Колонки.Добавить("Имя");
	тзСотрудники.Колонки.Добавить("Длительность");

	Если ДокументОбъект.ВидЗвонка = Перечисления.ПТ20_ТипыЗвонков.Входящий Тогда
		Клиент = НовыйАбонент(
			ДеталиЗвонка[0].КтоЗвонил,
			ДеталиЗвонка[0].КтоЗвонилВладелец,
			ДеталиЗвонка[0].from_number);
		КлиентСсылка = ?(ЗначениеЗаполнено(ДеталиЗвонка[0].КтоЗвонилВладелец),
			ДеталиЗвонка[0].КтоЗвонилВладелец,
			ДеталиЗвонка[0].КтоЗвонил);
	Иначе
		Клиент = НовыйАбонент(
			ДеталиЗвонка[0].КомуЗвонил,
			ДеталиЗвонка[0].КомуЗвонилВладелец,
			ДеталиЗвонка[0].to_number);
		КлиентСсылка = ?(ЗначениеЗаполнено(ДеталиЗвонка[0].КомуЗвонилВладелец),
			ДеталиЗвонка[0].КомуЗвонилВладелец,
			ДеталиЗвонка[0].КомуЗвонил);

		СтрокаКому = тзСотрудники.Добавить();
		СтрокаКому.Имя          = ?(ЗначениеЗаполнено(ДеталиЗвонка[0].КтоЗвонил),
		                            ДеталиЗвонка[0].КтоЗвонил, ДеталиЗвонка[0].from_number);
		СтрокаКому.Длительность = ДеталиЗвонка[0].ДлительностьРазговора - Дата(1, 1, 1);

		Телефоны = Новый Массив;
		Телефоны.Добавить(ДеталиЗвонка[0].from_number);
		ТелефоныСотрудников.Вставить(СтрокаКому.Имя, Телефоны);
	КонецЕсли;

	Для Каждого СтрокаДетализации Из ДеталиЗвонка Цикл

		// В первую очередь будем показывать пользователей, игнорируя очереди и другие служебные номера.
		Если СтрокаДетализации.to_extension <> "@app" И
			 СлужебныеНомера.Найти(СтрокаДетализации.to_number, "Номер") = Неопределено И
			 (СтрокаДетализации.status = Перечисления.ПТ20_СтатусЗвонка.ANSWER
				Или СтрокаДетализации.status = Перечисления.ПТ20_СтатусЗвонка.NOANSWER)
		Тогда
			Если ЗначениеЗаполнено(СтрокаДетализации.КомуЗвонил)
			   И ТипЗнч(СтрокаДетализации.КомуЗвонил) = Тип("СправочникСсылка.Пользователи") Тогда
				СтрокаКому = тзСотрудники.Добавить();
				СтрокаКому.Имя          = ?(ЗначениеЗаполнено(СтрокаДетализации.КомуЗвонил),
			                                СтрокаДетализации.КомуЗвонил, СтрокаДетализации.to_number);
				СтрокаКому.Длительность = СтрокаДетализации.ДлительностьРазговора - Дата(1, 1, 1);

				Телефоны = ТелефоныСотрудников.Получить(СтрокаДетализации.КомуЗвонил);
				Если Телефоны = Неопределено Тогда
					Телефоны = Новый Массив;
				КонецЕсли;
				Если Телефоны.Найти(СтрокаДетализации.to_number) = Неопределено Тогда
					Телефоны.Добавить(СтрокаДетализации.to_number);
				КонецЕсли;

				ТелефоныСотрудников.Вставить(СтрокаДетализации.КомуЗвонил, Телефоны);
			КонецЕсли;

			Если СтрокаДетализации.status = Перечисления.ПТ20_СтатусЗвонка.ANSWER Тогда
				ПрочиеУчастники.Вставить(СтрокаДетализации.to_number, СтрокаДетализации.to_number);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	// Один сотрудник - одно упоминание.
	тзСотрудники.Свернуть("Имя", "Длительность");
	тзСотрудники.Колонки.Добавить("НомерТелефона");
	Для Каждого СтрокаТЗ Из тзСотрудники Цикл
		Телефоны = ТелефоныСотрудников[СтрокаТЗ.Имя];
		Если Не Телефоны = Неопределено Тогда
			СтрокаТЗ.НомерТелефона = СтрСоединить(Телефоны, ", ");
		КонецЕсли;
	КонецЦикла;

	тзСотрудники.Сортировать("Длительность Убыв");
	Для Каждого СтрокаТЗ Из тзСотрудники Цикл
		мСотрудники.Добавить(НовыйАбонент(
				СтрокаТЗ.Имя,
				"",
				СтрокаТЗ.НомерТелефона));
	КонецЦикла;

	// Покажем хотя бы кого-то.
	Если мСотрудники.Количество() = 0 Тогда

		Если ПрочиеУчастники.Количество() > 0 Тогда
			Для Каждого Участник Из ПрочиеУчастники Цикл
				мСотрудники.Добавить(НовыйАбонент(
					"",
					"",
					Участник.Значение));
			КонецЦикла;
		Иначе
			мСотрудники.Добавить(НовыйАбонент(
				ДеталиЗвонка[0].КомуЗвонил,
				ДеталиЗвонка[0].КомуЗвонилВладелец,
				ДеталиЗвонка[0].to_number));
		КонецЕсли;

	КонецЕсли;

	// Форматируем имена абонентов.
	СотрудникиКратко   = Новый Массив;
	СотрудникиДетально = Новый Массив;

	Для Каждого Сотрудник Из мСотрудники Цикл
		СотрудникиКратко.Добавить(ПТ20_ЖурналЗвонковКлиентСервер.ФорматАбонента(
			Сотрудник.Имя, Сотрудник.Владелец, Сотрудник.НомерТелефона, Ложь));
		СотрудникиДетально.Добавить(ПТ20_ЖурналЗвонковКлиентСервер.ФорматАбонента(
			Сотрудник.Имя, Сотрудник.Владелец, Сотрудник.НомерТелефона, Истина));
	КонецЦикла;

	ДокументОбъект.Сотрудники = СтрСоединить(СотрудникиКратко, ", ");
	ДокументОбъект.НомерТелефона = ПТ20_Телефония.ПредставлениеНомераТелефона(Клиент.НомерТелефона);

	// Определим принадлежность номера телефона к региону.
	Расположение = ПТ20_Телефония.ОпределитьРегион(ДокументОбъект.НомерТелефона);
	Если Не Расположение = Неопределено Тогда
		ДокументОбъект.Регион = Расположение.Регион;
	КонецЕсли;

	// Для случаев как УТ, где контрагенты подчинены партнерам.
	Если ЗначениеЗаполнено(КлиентСсылка) И
		 Не ПТ20_ОбщегоНазначения.ИмяСправочникаПоТипу(ТипЗнч(КлиентСсылка)) = ПТ20_ТелефонияПовтИсп.ИмяСправочникаКлиенты() Тогда
		ДанныеВладельца = ПТ20_ОбщегоНазначения.НайтиВладельцаСправочника(КлиентСсылка.Метаданные(), ПТ20_ОбщегоНазначения.НайтиСправочникиСНомерамиТелефонов());
		Если Не ДанныеВладельца = Неопределено И ДанныеВладельца.Свойство("РеквизитСвязи") Тогда
			ВладелецСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КлиентСсылка, ДанныеВладельца.РеквизитСвязи);
			Если ЗначениеЗаполнено(ВладелецСсылка) Тогда
				КлиентСсылка = ВладелецСсылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если ДокументОбъект.ВидЗвонка = Перечисления.ПТ20_ТипыЗвонков.Входящий Тогда
		ДокументОбъект.КлиентСсылка = КлиентСсылка;
		ДокументОбъект.КлиентПредставление = ?(ЗначениеЗаполнено(КлиентСсылка), Строка(КлиентСсылка), ДокументОбъект.НомерТелефона);

		ДокументОбъект.КтоЗвонил = ПТ20_ЖурналЗвонковКлиентСервер.ФорматАбонента(
			Клиент.Имя, Клиент.Владелец, Клиент.НомерТелефона, Истина);
		ДокументОбъект.КомуЗвонил = СтрСоединить(СотрудникиДетально, ", ");
	ИначеЕсли ДокументОбъект.ВидЗвонка = Перечисления.ПТ20_ТипыЗвонков.Исходящий Тогда
		ДокументОбъект.КлиентСсылка = КлиентСсылка;
		ДокументОбъект.КлиентПредставление = ?(ЗначениеЗаполнено(КлиентСсылка), Строка(КлиентСсылка), ДокументОбъект.НомерТелефона);

		ДокументОбъект.КомуЗвонил = ПТ20_ЖурналЗвонковКлиентСервер.ФорматАбонента(
			Клиент.Имя, Клиент.Владелец, Клиент.НомерТелефона, Истина);
		ДокументОбъект.КтоЗвонил = СтрСоединить(СотрудникиДетально, ", ");
	Иначе
		ДокументОбъект.КтоЗвонил = ПТ20_ЖурналЗвонковКлиентСервер.ФорматАбонента(
			ДеталиЗвонка[0].КтоЗвонил, "", ДеталиЗвонка[0].from_number, Истина);
		ДокументОбъект.КомуЗвонил = ПТ20_ЖурналЗвонковКлиентСервер.ФорматАбонента(
			ДеталиЗвонка[0].КомуЗвонил, "", ДеталиЗвонка[0].to_number, Истина);
	КонецЕсли;

КонецПроцедуры

Функция НовыйАбонент(Имя, Владелец, НомерТелефона)
	Возврат Новый Структура("Имя,Владелец,НомерТелефона", Имя, Владелец, НомерТелефона);
КонецФункции

Процедура ПроверитьОбработкуПропущенныхЗвонков(МассивСсылок)

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ПТ20_ЗаписьЖурналаЗвонков.Дата, ДЕНЬ) КАК Дата
		|ПОМЕСТИТЬ втДаты
		|ИЗ
		|	Документ.ПТ20_ЗаписьЖурналаЗвонков КАК ПТ20_ЗаписьЖурналаЗвонков
		|ГДЕ
		|	ПТ20_ЗаписьЖурналаЗвонков.Ссылка В(&МассивСсылок)
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(ПТ20_ЗаписьЖурналаЗвонков.Дата, ДЕНЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПТ20_ЗаписьЖурналаЗвонков.НомерТелефонаИндекс КАК НомерТелефонаИндекс,
		|	ПТ20_ЗаписьЖурналаЗвонков.КлиентСсылка КАК КлиентСсылка,
		|	ПТ20_ЗаписьЖурналаЗвонков.Ссылка КАК Ссылка,
		|	ПТ20_ЗаписьЖурналаЗвонков.Дата КАК Дата
		|ПОМЕСТИТЬ втПропущенныеЗаДень
		|ИЗ
		|	Документ.ПТ20_ЗаписьЖурналаЗвонков КАК ПТ20_ЗаписьЖурналаЗвонков
		|ГДЕ
		|	ПТ20_ЗаписьЖурналаЗвонков.Пропущен = ИСТИНА
		|	И НАЧАЛОПЕРИОДА(ПТ20_ЗаписьЖурналаЗвонков.Дата, ДЕНЬ) В
		|			(ВЫБРАТЬ
		|				втДаты.Дата
		|			ИЗ
		|				втДаты)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПТ20_ЗаписьЖурналаЗвонков.Ссылка КАК Ссылка,
		|	ПТ20_ЗаписьЖурналаЗвонков.НомерТелефонаИндекс КАК НомерТелефонаИндекс,
		|	ПТ20_ЗаписьЖурналаЗвонков.КлиентСсылка КАК КлиентСсылка,
		|	ПТ20_ЗаписьЖурналаЗвонков.Дата КАК Дата
		|ПОМЕСТИТЬ втЗвонкиЗаДень
		|ИЗ
		|	Документ.ПТ20_ЗаписьЖурналаЗвонков КАК ПТ20_ЗаписьЖурналаЗвонков
		|ГДЕ
		|	ПТ20_ЗаписьЖурналаЗвонков.Ссылка В(&МассивСсылок)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втПропущенныеЗаДень.Ссылка КАК Ссылка
		|ИЗ
		|	втПропущенныеЗаДень КАК втПропущенныеЗаДень
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗвонкиЗаДень КАК втЗвонкиЗаДень
		|		ПО (втПропущенныеЗаДень.НомерТелефонаИндекс = втЗвонкиЗаДень.НомерТелефонаИндекс
		|				ИЛИ втПропущенныеЗаДень.КлиентСсылка = втЗвонкиЗаДень.КлиентСсылка
		|					И втПропущенныеЗаДень.КлиентСсылка <> НЕОПРЕДЕЛЕНО
		|					И втПропущенныеЗаДень.КлиентСсылка <> ЗНАЧЕНИЕ(Справочник.%Клиенты%.ПустаяСсылка))
		|			И втПропущенныеЗаДень.Дата < втЗвонкиЗаДень.Дата";

	ИмяСправочникаКлиенты = ПТ20_ТелефонияПовтИсп.ИмяСправочникаКлиенты();
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%Клиенты%", ИмяСправочникаКлиенты);

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ПТ20_НеобработанныеЗвонки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Ссылка = Выборка.Ссылка;
		МенеджерЗаписи.Удалить();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
